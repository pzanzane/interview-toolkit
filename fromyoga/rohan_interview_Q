import java.util.*;
class HelloWorld {
    private Stack<String> backHistory = new Stack<>();
    private Stack<String> forward = new Stack<>();
    private String currentUrl;
        public HelloWorld() {
        currentUrl = "https://www.google.com"; //Initial Url
        backHistory.push(currentUrl);
    }
    
    public String getCurrentUrl() {
        return currentUrl;
    }
    
    public void visitUrl(String url) {
        if(!url.equals(currentUrl)) {
            backHistory.push(url);
            currentUrl = url;
            forward.clear();
        }
    }
    
    private String goBack() {
            if(!backHistory.isEmpty()) {
                forward.push(currentUrl);
                backHistory.pop();
                currentUrl = backHistory.isEmpty() ? "" : backHistory.peek();
            }
            return currentUrl;
     } 
     
     private String goForward(){
         if(forward.size()>1) {
                backHistory.push(forward.pop());
                currentUrl = backHistory.peek();
            } else if(!forward.isEmpty()) {
                backHistory.push(forward.pop());
                currentUrl = backHistory.peek();
                forward.clear();
            }
        return currentUrl;
     }
     
         public static void main(String[] args) {
        HelloWorld obj = new HelloWorld();
        System.out.println("Current Url:" + obj.getCurrentUrl());
        obj.visitUrl("https://www.amazon.in");
