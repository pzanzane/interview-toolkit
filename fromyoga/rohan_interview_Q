          System.out.println("Forward:" + obj.goForward());
    System.out.println("Current Url:" + obj.getCurrentUrl());
     System.out.println("Forward:" + obj.goForward());
    System.out.println("Current Url:" + obj.getCurrentUrl());
         
    }
    
}

