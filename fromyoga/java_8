19. Find Duplicates (without using explicitly SET)
    "FOR NUMBERS
  int[] intArray = {5, 6, 8, 9, 1, 5};
  int[] duplicates = IntStream.of(intArray)
                  .filter(i -> Collections.frequency(listInteger, i) > 1)
                  .distinct()
                  .toArray();
  
  For STRING
  String[] strArray = {""AA"", ""CC"", ""AA"", ""DD"", ""CC"", ""FF""};
          List<String> listInteger = Stream.of(strArray).collect(Collectors.toList());
  
  Map<String, Long> duplicates = Stream.of(strArray)
                  .filter(i -> Collections.frequency(listInteger, i) > 1)
                  .collect(Collectors.groupingBy(Function.identity(), LinkedHashMap::new, Collectors.counting()));



