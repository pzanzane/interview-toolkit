public static class EmployeeWithDepartment {

        private final String department;
        private final int salary;

        public EmployeeWithDepartment(String department, int salary) {
            this.department = department;
            this.salary = salary;
        }

        public String getDepartment() {
            return department;
        }

        public int getSalary() {
            return salary;
        }

        @Override
        public String toString() {
            return String.format("[Department: %s - Salary: %s]", department, salary);
        }
    }

